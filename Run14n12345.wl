root=DirectoryName[$InputFileName];
Get[FileNameJoin[{root,"Hyperbolic3Manifolds.wl"}]];
out=FileNameJoin[{root,"outputs"}];If[!DirectoryQ[out],CreateDirectory[out]];
require[x_]:=If[!AssociationQ[x],Print["Stage failed: ",x];Exit[1],x];
record=require[Import[FileNameJoin[{root,"data","14n12345-record.json"}],"RawJSON"]];
Print["Decoding signature."];
tri=require[DecodeTriangulation[record["triangulation"]]];
Print["Tetrahedra: ",tri["Tetrahedra"],"; angle rank: ",MatrixRank[AngleSystem[tri]["Matrix"]]];
Export[FileNameJoin[{out,"face-pairings.json"}],tri,"RawJSON"];
Print["Solving complete structure."];
structure=require[SolveCompleteStructure[tri,120,45]];
Export[FileNameJoin[{out,"structure.wxf"}],structure,"WXF"];
Print["Volume: ",N[structure["Volume"],55]];
Print["Edge residual: ",structure["ComplexEdgeResidual"]];
Print["Developing holonomy and constructing domain."];
holonomy=BuildHolonomy[tri,structure];
Export[FileNameJoin[{out,"holonomy.wxf"}],holonomy,"WXF"];
domain=require[BuildDirichletDomain[holonomy]];
Export[FileNameJoin[{out,"domain.wxf"}],domain,"WXF"];
Print["Domain V,E,F: ",Length /@ Lookup[domain,{"Vertices","Edges","Faces"}]];
Print["Integrating domain."];
integral=IntegrateDomainVolume[domain,10];
Export[FileNameJoin[{out,"domain-integral.wxf"}],integral,"WXF"];
Print["Integral: ",N[integral["Volume"],16]];
Print["Difference: ",N[integral["Volume"]-structure["Volume"]]];
Get[FileNameJoin[{root,"MakeReport.wl"}]];
